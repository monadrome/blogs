# === self-media 项目配置 ===

# 掘金（cookie 认证，从浏览器 DevTools 复制）
JUEJIN_COOKIE="sessionid=xxx; sessionid_ss=xxx; passport_csrf_token=xxx"
JUEJIN_DEFAULT_CATEGORY="6809637769959178254"
# 可选分类 ID:
#   6809637767543259144 = 前端
#   6809637769959178254 = 后端
#   6809637777523272712 = AI
#   6809637773990930440 = 开发工具
#   6809637781306523662 = 代码人生

# 微信公众号（API 方式）
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# 图片生成后端（baoyu-imagine 使用）
OPENAI_API_KEY=""
# DASHSCOPE_API_KEY=""
# GOOGLE_API_KEY=""

# Git 自动推送
GIT_AUTO_PUSH="false"
GIT_REMOTE="origin"
GIT_BRANCH="main"

# 定时调度
SCHEDULER_ENABLED="false"
SCHEDULER_INTERVAL="600"

# 开源博客同步
# OPEN_SOURCE_GITHUB_REPO="https://github.com/username/blog.git"
# OPEN_SOURCE_LOCAL_DIR=""
# OPEN_SOURCE_BRANCH="main"
# OPEN_SOURCE_AUTO_PUSH="false"
